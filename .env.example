# Development databases (see docs/dev-setup.md). Port 5434 is the SSH tunnel to the VPS Postgres.
DATABASE_URL=postgresql://galaxy_dev:CHANGE_ME@localhost:5434/promptgalaxy_dev
# Used only by `pnpm test`. The database name MUST contain "test".
TEST_DATABASE_URL=postgresql://galaxy_dev:CHANGE_ME@localhost:5434/promptgalaxy_test

# Optional. Where uploaded images are stored (default: ./uploads).
# UPLOADS_DIR=/opt/apps/thepromptgalaxy/uploads

# Public site URL (used for canonical links, sitemap and structured data).
# SITE_URL=https://thepromptgalaxy.com
