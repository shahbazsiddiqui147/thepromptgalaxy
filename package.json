  },
  "dependencies": {
    "next": "16.2.10",
    "pg": "^8.13.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/pg": "^8.11.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "^3.2.4"
  }
}
